# === GigaChat ===
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# === YandexGPT ===
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=gpt://your_folder_id/yandexgpt/latest

# External AI processing is disabled unless the clinic has enabled it
# after reviewing legal, security, and patient-consent requirements.
EXTERNAL_AI_ENABLED=false

# Optional trusted CA bundle for an authorized VPN/HTTPS proxy.
# Obtain and verify this certificate with your network administrator.
# SSL_CERT_FILE=C:\Med_centr\backend\certs\organization-proxy-ca.pem

# === Database ===
DATABASE_URL=sqlite:///./dental.db
